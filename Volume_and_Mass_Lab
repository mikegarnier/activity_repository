<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Measuring Volume Lab</title>
<style>
  :root { --ink:#1d2b36; --accent:#0b6e99; --bg:#eef3f7; }
  * { box-sizing:border-box; }
  body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif; background:var(--bg); color:var(--ink); }
  header { background:#123a52; color:#fff; padding:8px 16px 0; display:flex; flex-wrap:wrap; align-items:flex-end; gap:6px 24px; }
  header h1 { margin:0 0 8px; font-size:1.3rem; }
  .tabs { display:flex; flex-wrap:wrap; gap:6px; }
  .tabs button { font:inherit; font-weight:600; padding:10px 16px; border:none; border-radius:8px 8px 0 0; background:#2b5874; color:#dce9f2; cursor:pointer; }
  .tabs button.active { background:var(--bg); color:#123a52; }
  main { max-width:1240px; margin:0 auto; padding:10px 16px 8px; }
  .station { display:none; }
  .station.active { display:block; }
  .panel { background:#fff; border-radius:10px; padding:14px 16px; box-shadow:0 1px 3px rgba(0,0,0,.12); margin-bottom:10px; }
  .panel.intro { padding:10px 16px; }
  .panel h2 { margin:0 0 4px; font-size:1.15rem; }
  .panel h3 { margin:0 0 8px; font-size:1.05rem; }
  .row { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:8px 0; }
  .row .gap { width:14px; }
  button.btn { font:inherit; padding:8px 12px; border:1px solid #9bb3c4; border-radius:8px; background:#f7fbfe; color:var(--ink); cursor:pointer; touch-action:manipulation; user-select:none; -webkit-user-select:none; }
  button.btn:hover { background:#e7f2f9; }
  button.btn.sel { background:var(--accent); color:#fff; border-color:var(--accent); }
  button.btn.big { padding:12px 16px; font-weight:600; }
  button.btn.sm { padding:5px 8px; font-size:.85rem; }
  .tip { font-size:.92rem; color:#3c5566; line-height:1.4; margin:2px 0; }
  .layout { display:grid; grid-template-columns:1fr 290px; gap:14px; align-items:stretch; }
  .layout > .workbox { align-self:start; }
  .layout, .layout2 { align-items:start; }
  .layout2 { display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:stretch; }
  .layout2 > svg { align-self:start; }
  .side { display:flex; flex-direction:column; gap:12px; }
  .side .panel { margin-bottom:0; padding:10px 14px; }
  .side .bal-panel { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
  .side .bal-panel svg.bal { flex:1 1 0; min-height:60px; height:auto; max-width:none; }
  .side .row { margin:4px 0; }
  .side h3 { margin-bottom:6px; }
  @media (max-width:900px) { .layout, .layout2 { grid-template-columns:1fr; } }
  svg.work { display:block; width:100%; height:auto; background:#fff; border:1px solid #c9d6df; border-radius:10px; touch-action:none; user-select:none; -webkit-user-select:none; }
  #ruler { cursor:grab; }
  .workbox { background:#fff; border:1px solid #c9d6df; border-radius:10px; overflow:hidden; display:flex; }
  .workbox svg.work { border:none; border-radius:0; flex:1; min-width:0; }
  .tools { display:flex; flex-direction:column; gap:6px; padding:10px 8px; background:#f3f7fa; border-right:1px solid #e3eaef; font-size:.85rem; width:112px; flex:none; }
  .tools b { margin-top:6px; }
  .tools .pair { display:grid; grid-template-columns:1fr 1fr; gap:4px; }
  .tools .dpad { display:grid; grid-template-columns:repeat(3,30px); grid-template-rows:repeat(3,30px); gap:3px; justify-content:center; }
  .tools .dpad button { padding:0; }
  .tools button.btn.sm { padding:5px 4px; }
  #rHandle { cursor:alias; }
  .picker { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
  .picker button { display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px; }
  .picker button.sel { background:#e3f1f8; color:var(--ink); border:2px solid var(--accent); }
  .picker svg { width:100%; height:auto; max-height:46px; }
  .picker button { font-size:.9rem; }
  .tray { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  @media (max-width:640px) { .tray { grid-template-columns:repeat(2,1fr); } }
  .card { border:1px solid #9bb3c4; border-radius:8px; padding:6px; display:flex; flex-direction:column; align-items:center; gap:4px; background:#f7fbfe; }
  .card.sel { border:2px solid var(--accent); background:#e3f1f8; }
  .card svg { width:100%; max-width:130px; height:auto; }
  .card .row { margin:2px 0 0; justify-content:center; gap:4px; }
  svg.bal { display:block; width:100%; max-width:320px; height:auto; margin:0 auto; }
  .msg { min-height:1.5em; font-weight:600; color:#8a4300; margin:8px 0 0; }
  table { border-collapse:collapse; width:100%; }
  th, td { border:1px solid #c5d3dd; padding:6px; text-align:center; }
  th { background:#e6eef4; font-size:.92rem; }
  .tablewrap { overflow-x:auto; }
  input.m { width:84px; padding:6px; font:inherit; text-align:center; border:2px solid #b8c7d2; border-radius:6px; }
  input.ok { border-color:#2e9d4f; background:#eaf8ee; }
  input.bad { border-color:#d0453b; background:#fdeceb; }
  .legend { font-size:.9rem; color:#3c5566; }
  .swatch { display:inline-block; width:12px; height:12px; border-radius:3px; vertical-align:-1px; margin:0 3px 0 8px; }
</style>
</head>
<body>

<header>
  <h1>Measuring Volume Lab</h1>
  <div class="tabs">
    <button class="active" data-tab="st-ruler">1 · Aluminum blocks (ruler)</button>
    <button data-tab="st-cyl">2 · Iron bolts (graduated cylinder)</button>
  </div>
</header>

<main>

<!-- ===================== STATION 1: RULER ===================== -->
<section id="st-ruler" class="station active">
  <div class="panel intro">
    <h2>Station 1: Measure aluminum blocks with a ruler</h2>
    <p class="tip">Drag the ruler onto an edge. Line up the <b>0 mark</b> (not the end of the ruler!) with a corner and read where the edge ends. Each small line is 1 mm = 0.1 cm. Measure <b>length</b> along the front bottom edge, <b>height</b> along a front upright edge, and <b>width</b> along the slanted edge going back (rotate the ruler to match it). You can also spin the ruler with its round ⟳ handle, and arrow keys nudge it.</p>
  </div>

  <div class="layout">
    <div class="workbox">
      <div class="tools">
        <b>Rotate</b>
        <div class="pair">
          <button class="btn sm" data-rot="-15">⟲ 15°</button>
          <button class="btn sm" data-rot="15">⟳ 15°</button>
          <button class="btn sm" data-rot="-1">⟲ 1°</button>
          <button class="btn sm" data-rot="1">⟳ 1°</button>
        </div>
        <b>Nudge</b>
        <div class="dpad">
          <span></span><button class="btn sm" data-nudge="0,-1" title="Up">▲</button><span></span>
          <button class="btn sm" data-nudge="-1,0" title="Left">◀</button><span></span><button class="btn sm" data-nudge="1,0" title="Right">▶</button>
          <span></span><button class="btn sm" data-nudge="0,1" title="Down">▼</button><span></span>
        </div>
        <b>Ruler</b>
        <button class="btn sm" id="resetBtn">Reset</button>
      </div>
      <svg id="rulerSvg" class="work fit" viewBox="0 0 960 600" aria-label="Ruler workspace">
        <defs>
          <linearGradient id="alum" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#eef0f2"/>
            <stop offset="0.5" stop-color="#c3c9ce"/>
            <stop offset="1" stop-color="#dde1e4"/>
          </linearGradient>
        </defs>
        <g id="rScene">
          <rect x="0" y="0" width="960" height="600" fill="#fbfcfd"/>
          <g id="blockG"></g>
          <g id="ruler"></g>
        </g>
      </svg>
    </div>
    <div class="side">
      <div class="panel">
        <h3>Choose a block</h3>
        <div class="picker" id="blockPick"></div>
      </div>
      <div class="panel bal-panel">
        <h3>Electronic balance</h3>
        <svg id="alBal" class="bal" viewBox="0 20 300 170"></svg>
        <div class="row" style="justify-content:center">
          <button class="btn sm" id="alWeigh">Put Block A on balance</button>
          <button class="btn sm" id="alClear">Clear balance</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== STATION 2: CYLINDER ===================== -->
<section id="st-cyl" class="station">
  <div class="panel intro">
    <h2>Station 2: Measure iron bolts by water displacement</h2>
    <p class="tip">Put water in the 100 mL graduated cylinder and read the level. Then drop in a bolt and read the level again. Always read the <b>bottom of the curved water surface</b> (the meniscus). Each small line is 1 mL, so estimate between lines. <b>Bolt volume = level after − level before.</b></p>
  </div>

  <div class="layout2">
    <svg id="cylSvg" class="work fit" viewBox="0 0 520 720" aria-label="Graduated cylinder">
      <defs>
        <linearGradient id="steel" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#4a4f54"/>
          <stop offset="0.45" stop-color="#9aa1a7"/>
          <stop offset="1" stop-color="#3f4448"/>
        </linearGradient>
      </defs>
      <g id="cScene"></g>
    </svg>

    <div class="side">
      <div class="panel">
        <h3>Water</h3>
        <div class="row">
          <button class="btn" id="fillBtn"><b>Fill to 50 mL</b></button>
          <button class="btn" id="removeBtn">Take bolt out</button>
          <button class="btn" id="emptyBtn">Empty cylinder</button>
          <button class="btn sel" id="cLensBtn">Magnifier: ON</button>
        </div>
      </div>
      <div class="panel">
        <h3>Iron bolts</h3>
        <div class="tray" id="tray"></div>
        <p class="msg" id="cylMsg"></p>
      </div>
      <div class="panel bal-panel">
        <h3>Electronic balance</h3>
        <svg id="feBal" class="bal" viewBox="0 50 300 140"></svg>
        <div class="row" style="justify-content:center">
          <button class="btn" id="feClear">Clear balance</button>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<script>
"use strict";
const $ = id => document.getElementById(id);
const NS = "http://www.w3.org/2000/svg";

/* ================= DATA (edit here) =================
   Aluminum blocks: dimensions in cm, mass in g.
   L × W × H matches the volume in the data chart.          */
const BLOCKS = [
  { name: "A", L: 5.0, W: 1.5, H: 1.5, mass: 30.38 },  // 11.25 cm³ → 2.70 g/cm³
  { name: "B", L: 4.8, W: 2.5, H: 1.3, mass: 42.12 },  // 15.6 cm³  → 2.70 g/cm³
  { name: "C", L: 4.5, W: 3.0, H: 2.0, mass: 72.90 },  // 27.0 cm³  → 2.70 g/cm³
  { name: "D", L: 5.0, W: 3.8, H: 2.0, mass: 102.60 }  // 38.0 cm³  → 2.70 g/cm³
];
/* Iron bolts: vol in mL, mass in g (7.87 g/mL). The other numbers only set
   how big each bolt is drawn on screen.                    */
const BOLTS = [
  { name: "A", vol: 1.0,  mass: 7.87,   headW: 18, headH: 8,  shankW: 10, shankL: 40 },
  { name: "B", vol: 3.0,  mass: 23.61,  headW: 24, headH: 10, shankW: 14, shankL: 60 },
  { name: "C", vol: 7.0,  mass: 55.09,  headW: 32, headH: 14, shankW: 20, shankL: 85 },
  { name: "D", vol: 21.0, mass: 165.27, headW: 46, headH: 20, shankW: 30, shankL: 125 }
];

/* ================= TABS ================= */
document.querySelectorAll(".tabs button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll(".tabs button").forEach(x => x.classList.toggle("active", x === b));
  document.querySelectorAll(".station").forEach(s => s.classList.toggle("active", s.id === b.dataset.tab));
}));

/* ================= FIT TO SCREEN =================
   Sizes the drawing areas so the whole station fits in the window. */
function fitToScreen() {
  document.querySelectorAll(".station.active svg.fit").forEach(svg => {
    if (window.innerWidth < 900) { svg.style.height = ""; svg.style.width = ""; return; }
    const top = svg.getBoundingClientRect().top + window.scrollY;
    const h = Math.max(360, window.innerHeight - top - 12);
    svg.style.height = h + "px";
    if (svg.id === "cylSvg") {          // tall drawing: size by height
      const vb = svg.viewBox.baseVal;
      svg.style.width = (h * vb.width / vb.height) + "px";
    }
  });
  // make the right-hand column exactly as tall as the drawing area
  document.querySelectorAll(".station.active .side").forEach(side => {
    if (window.innerWidth < 900) { side.style.height = ""; return; }
    const left = side.previousElementSibling;
    side.style.height = left.getBoundingClientRect().height + "px";
  });
}
window.addEventListener("resize", fitToScreen);
document.querySelectorAll(".tabs button").forEach(b => b.addEventListener("click", fitToScreen));

/* ================= HELPERS ================= */
function svgPt(svg, e) {
  const p = svg.createSVGPoint();
  p.x = e.clientX; p.y = e.clientY;
  return p.matrixTransform(svg.getScreenCTM().inverse());
}
function rot(a, x, y) {
  const r = a * Math.PI / 180, c = Math.cos(r), s = Math.sin(r);
  return { x: x * c - y * s, y: x * s + y * c };
}

/* Magnifying lens: shows an enlarged copy of the scene above the pointer */
function makeLens(svg, sceneId, R, Z, btn) {
  const clipId = sceneId + "Clip";
  const cp = document.createElementNS(NS, "clipPath");
  cp.setAttribute("id", clipId);
  const cc = document.createElementNS(NS, "circle");
  cc.setAttribute("r", R);
  cp.appendChild(cc);
  svg.querySelector("defs").appendChild(cp);

  const g = document.createElementNS(NS, "g");
  g.setAttribute("pointer-events", "none");
  g.style.display = "none";
  const inner = document.createElementNS(NS, "g");
  inner.setAttribute("clip-path", "url(#" + clipId + ")");
  const use = document.createElementNS(NS, "use");
  use.setAttribute("href", "#" + sceneId);
  inner.appendChild(use);
  g.appendChild(inner);
  const rim = document.createElementNS(NS, "circle");
  rim.setAttribute("r", R);
  rim.setAttribute("fill", "none");
  rim.setAttribute("stroke", "#2b3a44");
  rim.setAttribute("stroke-width", "5");
  g.appendChild(rim);
  svg.appendChild(g);

  let on = true, last = null;
  function place(p) {
    last = p;
    if (!on) { g.style.display = "none"; return; }
    const vb = svg.viewBox.baseVal;
    const cx = Math.min(vb.width - R - 4, Math.max(R + 4, p.x));
    let cy = p.y - R - 35;
    if (cy - R < 0) cy = p.y + R + 35;
    cc.setAttribute("cx", cx); cc.setAttribute("cy", cy);
    rim.setAttribute("cx", cx); rim.setAttribute("cy", cy);
    use.setAttribute("transform", `translate(${cx} ${cy}) scale(${Z}) translate(${-p.x} ${-p.y})`);
    g.style.display = "";
  }
  svg.addEventListener("pointermove", e => place(svgPt(svg, e)));
  svg.addEventListener("pointerdown", e => place(svgPt(svg, e)));
  btn.addEventListener("click", () => {
    on = !on;
    btn.textContent = "Magnifier: " + (on ? "ON" : "OFF");
    btn.classList.toggle("sel", on);
    if (on && last) place(last); else g.style.display = "none";
  });
}

/* Electronic balance drawing. set(markup, mass) puts an object on the pan. */
function makeBalance(svg) {
  svg.innerHTML =
    `<rect x="0" y="0" width="300" height="190" fill="#fff"/>` +
    `<rect x="14" y="112" width="272" height="70" rx="10" fill="#e4e9ed" stroke="#8796a1" stroke-width="2"/>` +
    `<rect x="136" y="104" width="28" height="9" fill="#9aa6af"/>` +
    `<rect x="48" y="96" width="204" height="10" rx="4" fill="#cdd5db" stroke="#7d8b95" stroke-width="1.5"/>` +
    `<g class="load"></g>` +
    `<rect x="34" y="126" width="150" height="40" rx="5" fill="#1d2a22" stroke="#55636c"/>` +
    `<text class="lcd" x="160" y="155" text-anchor="end" font-family="'Courier New', monospace" font-size="26" font-weight="700" fill="#7dff9b">0.00</text>` +
    `<text x="168" y="155" font-family="'Courier New', monospace" font-size="18" font-weight="700" fill="#7dff9b">g</text>` +
    `<circle cx="214" cy="146" r="11" fill="#c0392b"/><text x="214" y="172" text-anchor="middle" font-size="9" fill="#55636c" font-family="Arial, sans-serif">ON</text>` +
    `<circle cx="252" cy="146" r="11" fill="#5f6f7b"/><text x="252" y="172" text-anchor="middle" font-size="9" fill="#55636c" font-family="Arial, sans-serif">TARE</text>`;
  const load = svg.querySelector(".load"), lcd = svg.querySelector(".lcd");
  let timer = null;
  return {
    set(markup, mass) {
      load.innerHTML = markup || "";
      clearInterval(timer);
      if (mass == null) { lcd.textContent = "0.00"; return; }
      let n = 0;
      timer = setInterval(() => {
        n++;
        if (n < 6) lcd.textContent = (mass * (0.55 + 0.08 * n) + (Math.random() - 0.5)).toFixed(2);
        else { lcd.textContent = mass.toFixed(2); clearInterval(timer); }
      }, 90);
    }
  };
}


/* =========================================================
   STATION 1: RULER + 3D BLOCK
   ========================================================= */
const PX = 60;              // screen units per cm
const R0 = 20;              // gap between end of ruler and the 0 mark
const RW = 56;              // ruler width
const RL = R0 + 300 + 52;   // ruler length: 5 cm scale + grip with rotate handle
const DEPTH_ANGLE = 30;     // the "going back" edge is drawn at this angle, at full scale
const BX = 260, BY = 420;   // front-bottom-left corner of the block
const rSvg = $("rulerSvg"), blockG = $("blockG"), rulerG = $("ruler");
let curBlock = 0;
let rx = 60, ry = 520, ang = 0;

/* 3D block, cavalier style: depth drawn at full scale so it can be measured */
function cube3D(b, s, x0, y0, stroke) {
  const L = b.L * s, H = b.H * s, D = b.W * s;
  const dx = D * Math.cos(DEPTH_ANGLE * Math.PI / 180), dy = D * Math.sin(DEPTH_ANGLE * Math.PI / 180);
  const P = pts => pts.map(p => p[0].toFixed(2) + "," + p[1].toFixed(2)).join(" ");
  const sw = stroke || 1;
  return `<polygon points="${P([[x0, y0 - H], [x0 + L, y0 - H], [x0 + L + dx, y0 - H - dy], [x0 + dx, y0 - H - dy]])}" fill="#eef1f3" stroke="#4d565e" stroke-width="${sw}" stroke-linejoin="round"/>` +
         `<polygon points="${P([[x0 + L, y0 - H], [x0 + L, y0], [x0 + L + dx, y0 - dy], [x0 + L + dx, y0 - H - dy]])}" fill="#a9b1b8" stroke="#4d565e" stroke-width="${sw}" stroke-linejoin="round"/>` +
         `<rect x="${x0}" y="${y0 - H}" width="${L}" height="${H}" fill="url(#alum)" stroke="#4d565e" stroke-width="${sw}"/>`;
}

function drawBlock() {
  const b = BLOCKS[curBlock];
  const L = b.L * PX, H = b.H * PX, D = b.W * PX;
  const dx = D * Math.cos(DEPTH_ANGLE * Math.PI / 180), dy = D * Math.sin(DEPTH_ANGLE * Math.PI / 180);
  blockG.innerHTML =
    `<text x="30" y="44" font-size="22" font-weight="700" fill="#1d2b36" font-family="Arial, sans-serif">Aluminum block ${b.name}</text>` +
    `<text x="30" y="68" font-size="15" fill="#3c5566" font-family="Arial, sans-serif">Measure along the edges of the block</text>` +
    cube3D(b, PX, BX, BY, 1) +
    `<text x="${BX + L / 2}" y="${BY + 24}" text-anchor="middle" font-size="16" font-weight="700" fill="#b03a2e" font-family="Arial, sans-serif">length</text>` +
    `<text transform="translate(${BX - 14} ${BY - H / 2}) rotate(-90)" text-anchor="middle" font-size="16" font-weight="700" fill="#1f6fb2" font-family="Arial, sans-serif">height</text>` +
    `<text transform="translate(${BX + L + dx / 2 + 14} ${BY - dy / 2 + 16}) rotate(${-DEPTH_ANGLE})" text-anchor="middle" font-size="16" font-weight="700" fill="#2e8b57" font-family="Arial, sans-serif">width</text>`;
  $("alWeigh").textContent = `Put Block ${b.name} on balance`;
  document.querySelectorAll("[data-block]").forEach(x => x.classList.toggle("sel", +x.dataset.block === curBlock));
}

(function buildRuler() {
  let s = `<rect x="0" y="0" width="${RL}" height="${RW}" rx="5" fill="rgba(252,236,160,0.85)" stroke="#9a8436" stroke-width="1.5"/>`;
  for (let mm = 0; mm <= 50; mm++) {
    const x = R0 + mm * PX / 10;
    const len = mm % 10 === 0 ? 24 : (mm % 5 === 0 ? 16 : 10);
    s += `<line x1="${x}" y1="0" x2="${x}" y2="${len}" stroke="#222" stroke-width="${mm % 10 === 0 ? 1.4 : 1}"/>`;
    if (mm % 10 === 0) {
      s += `<text x="${x}" y="42" font-size="15" text-anchor="middle" fill="#222" font-family="Arial, sans-serif">${mm / 10}</text>`;
    }
  }
  s += `<text x="${R0 + 28}" y="42" font-size="12" text-anchor="middle" fill="#555" font-family="Arial, sans-serif">cm</text>`;
  s += `<g id="rHandle"><circle cx="${RL - 24}" cy="${RW / 2}" r="17" fill="#e2c35a" stroke="#8a742c" stroke-width="2"/>` +
       `<text x="${RL - 24}" y="${RW / 2 + 7}" text-anchor="middle" font-size="20" fill="#5a4a14" font-family="Arial, sans-serif">⟳</text></g>`;
  rulerG.innerHTML = s;
})();

function placeRuler() {
  rulerG.setAttribute("transform", `translate(${rx} ${ry}) rotate(${ang})`);
}
function rulerCenter() {
  const v = rot(ang, RL / 2, RW / 2);
  return { x: rx + v.x, y: ry + v.y };
}
function setCenter(c) {
  const v = rot(ang, RL / 2, RW / 2);
  rx = c.x - v.x; ry = c.y - v.y;
}
function clampRuler() {
  const c = rulerCenter();
  c.x = Math.min(940, Math.max(20, c.x));
  c.y = Math.min(580, Math.max(20, c.y));
  setCenter(c);
  placeRuler();
}
function rotateBy(d) {
  const c = rulerCenter();
  ang = ((ang + d) % 360 + 360) % 360;
  setCenter(c);
  clampRuler();
}

document.querySelectorAll("[data-rot]").forEach(b => b.addEventListener("click", () => rotateBy(+b.dataset.rot)));
$("resetBtn").addEventListener("click", () => { ang = 0; rx = 60; ry = 520; placeRuler(); });

/* Dragging: the ruler body moves it, the round handle spins it */
let drag = null, spin = null;
rulerG.addEventListener("pointerdown", e => {
  const p = svgPt(rSvg, e);
  drag = { dx: p.x - rx, dy: p.y - ry };
  rSvg.setPointerCapture(e.pointerId);
  rulerG.style.cursor = "grabbing";
  e.preventDefault();
});
$("rHandle").addEventListener("pointerdown", e => {
  spin = { c: rulerCenter() };
  rSvg.setPointerCapture(e.pointerId);
  e.stopPropagation();
  e.preventDefault();
});
rSvg.addEventListener("pointermove", e => {
  const p = svgPt(rSvg, e);
  if (spin) {
    ang = Math.atan2(p.y - spin.c.y, p.x - spin.c.x) * 180 / Math.PI;
    ang = (ang + 360) % 360;
    setCenter(spin.c);
    placeRuler();
  } else if (drag) {
    rx = p.x - drag.dx;
    ry = p.y - drag.dy;
    clampRuler();
  }
});
function endDrag() { drag = null; spin = null; rulerG.style.cursor = "grab"; }
rSvg.addEventListener("pointerup", endDrag);
rSvg.addEventListener("pointercancel", endDrag);

function nudge(dx, dy) { rx += dx; ry += dy; clampRuler(); }
document.querySelectorAll("[data-nudge]").forEach(b => b.addEventListener("click", e => {
  const [dx, dy] = b.dataset.nudge.split(",").map(Number);
  const k = e.shiftKey ? 6 : 1;
  nudge(dx * k, dy * k);
}));
document.addEventListener("keydown", e => {
  if (!$("st-ruler").classList.contains("active")) return;
  if (/INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
  const map = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
  const d = map[e.key];
  if (!d) return;
  e.preventDefault();
  const k = e.shiftKey ? 6 : 1;
  nudge(d[0] * k, d[1] * k);
});

/* Block picker (right-hand column) */
$("blockPick").innerHTML = BLOCKS.map((b, i) =>
  `<button class="btn${i === 0 ? " sel" : ""}" data-block="${i}">
     <svg viewBox="0 0 140 110">${cube3D(b, 14, 10, 96, 1.2)}</svg>
     <b>Block ${b.name}</b>
   </button>`).join("");
document.querySelectorAll("[data-block]").forEach(b => b.addEventListener("click", () => {
  curBlock = +b.dataset.block;
  drawBlock();
}));

/* Balance for blocks */
const alBal = makeBalance($("alBal"));
$("alWeigh").addEventListener("click", () => {
  const b = BLOCKS[curBlock], s = 18;
  const w = b.L * s + b.W * s * Math.cos(DEPTH_ANGLE * Math.PI / 180);
  alBal.set(cube3D(b, s, 150 - w / 2, 96, 1), b.mass);
});
$("alClear").addEventListener("click", () => alBal.set("", null));


drawBlock();
placeRuler();

/* =========================================================
   STATION 2: GRADUATED CYLINDER
   ========================================================= */
const cScene = $("cScene");
const C = { x0: 180, x1: 280, y0: 660, k: 6, top: 34, cap: 103.5, bx: 252 }; // k = screen units per mL
const yOf = v => C.y0 - C.k * v;
BOLTS.forEach(b => { b.minLevel = Math.ceil((b.headH + b.shankL) / C.k) + 3; });

let water = 0, bolt = null, boltY = 0, boltV = 0, falling = false;
let shown = 0, lastT = 0, dirty = true;
let onBalance = null;    // index of the bolt sitting on the balance

function say(t) { $("cylMsg").textContent = t; }

function boltMarkup(b, cx, bottom) {
  const hw = b.headW, hh = b.headH, sw = b.shankW, sl = b.shankL;
  const top = bottom - hh - sl;
  let s = `<rect x="${cx - sw / 2}" y="${top}" width="${sw}" height="${sl}" fill="url(#steel)" stroke="#2c2f32" stroke-width="1"/>`;
  for (let y = top + 3; y < bottom - hh - 2; y += 4) {
    s += `<line x1="${cx - sw / 2}" y1="${y + 2}" x2="${cx + sw / 2}" y2="${y}" stroke="#2f3336" stroke-width="0.8"/>`;
  }
  s += `<rect x="${cx - hw / 2}" y="${bottom - hh}" width="${hw}" height="${hh}" rx="1.5" fill="url(#steel)" stroke="#2c2f32" stroke-width="1"/>`;
  s += `<line x1="${cx - hw / 6}" y1="${bottom - hh}" x2="${cx - hw / 6}" y2="${bottom}" stroke="#3a3e42" stroke-width="1"/>`;
  s += `<line x1="${cx + hw / 6}" y1="${bottom - hh}" x2="${cx + hw / 6}" y2="${bottom}" stroke="#3a3e42" stroke-width="1"/>`;
  return s;
}
/* A bolt lying on its side, its bottom resting at y = restY, centered at cx */
function boltLying(b, cx, restY, s) {
  const len = (b.headH + b.shankL) * s;
  return `<g transform="translate(${cx - len / 2} ${restY - b.headW * s / 2}) scale(${s}) rotate(90)">${boltMarkup(b, 0, 0)}</g>`;
}

function renderCyl() {
  const lvl = shown, Ly = yOf(lvl);
  let s = `<rect x="0" y="0" width="520" height="720" fill="#f6f9fb"/>`;
  s += `<rect x="0" y="690" width="520" height="30" fill="#d9cbb3"/>`;


  // glass interior
  s += `<rect x="${C.x0}" y="${C.top}" width="${C.x1 - C.x0}" height="${C.y0 - C.top}" fill="rgba(210,232,245,0.55)"/>`;

  // bolt (drawn before water so the water tints it)
  if (bolt) s += boltMarkup(bolt, C.bx, boltY);


  // water with meniscus (bottom of the curve sits exactly at the true level)
  if (lvl > 0.05) {
    const surf = `M${C.x0} ${Ly - 5} Q${C.x0 + 6} ${Ly} ${C.x0 + 16} ${Ly} L${C.x1 - 16} ${Ly} Q${C.x1 - 6} ${Ly} ${C.x1} ${Ly - 5}`;
    s += `<path d="${surf} L${C.x1} ${C.y0} L${C.x0} ${C.y0} Z" fill="rgba(70,150,220,0.38)"/>`;
    s += `<path d="${surf}" fill="none" stroke="rgba(20,80,150,0.9)" stroke-width="1.2"/>`;
  }

  // base and glass walls
  s += `<path d="M120 690 L340 690 L322 ${C.y0 + 4} L138 ${C.y0 + 4} Z" fill="#cfe1ec" stroke="#6f93a8" stroke-width="2"/>`;
  s += `<path d="M${C.x0 - 3} ${C.top} L${C.x0 - 3} ${C.y0 + 3} L${C.x1 + 3} ${C.y0 + 3} L${C.x1 + 3} ${C.top}" fill="none" stroke="#7a9bb0" stroke-width="5" stroke-linejoin="round"/>`;
  s += `<path d="M${C.x0 - 9} ${C.top} L${C.x1 + 14} ${C.top - 4}" stroke="#7a9bb0" stroke-width="5" stroke-linecap="round"/>`;

  // graduations: 1 mL minor, 5 mL medium, 10 mL labeled
  for (let v = 1; v <= 100; v++) {
    const y = yOf(v);
    const len = v % 10 === 0 ? 44 : (v % 5 === 0 ? 28 : 15);
    s += `<line x1="${C.x0}" y1="${y}" x2="${C.x0 + len}" y2="${y}" stroke="#1d2b36" stroke-width="${v % 10 === 0 ? 1.6 : 1}"/>`;
    if (v % 10 === 0) {
      s += `<text x="${C.x0 - 12}" y="${y + 5}" text-anchor="end" font-size="15" font-weight="600" fill="#1d2b36" font-family="Arial, sans-serif">${v}</text>`;
    }
  }
  s += `<text x="${C.x0 - 12}" y="${yOf(100) - 14}" text-anchor="end" font-size="13" fill="#1d2b36" font-family="Arial, sans-serif">mL</text>`;

  // glass highlight
  s += `<rect x="${C.x1 - 14}" y="${C.top + 10}" width="5" height="${C.y0 - C.top - 30}" fill="rgba(255,255,255,0.5)"/>`;

  cScene.innerHTML = s;
}

function boltVolNow() { return bolt && !falling ? bolt.vol : 0; }
function targetLevel() { return water + boltVolNow(); }

function overflowCheck() {
  if (water + boltVolNow() > C.cap) {
    water = Math.max(0, C.cap - boltVolNow());
    say("Oops! Water spilled over the top. Empty the cylinder and start with less water.");
  }
}

$("fillBtn").addEventListener("click", () => {
  water = 50;
  overflowCheck();
  say("Water added. Read the level before adding a bolt.");
  dirty = true;
});
$("emptyBtn").addEventListener("click", () => {
  water = 0; bolt = null; falling = false;
  updateTray();
  say("Cylinder emptied.");
  dirty = true;
});
$("removeBtn").addEventListener("click", () => {
  if (!bolt) { say("There's no bolt in the cylinder."); return; }
  bolt = null; falling = false;
  updateTray();
  say("Bolt taken out (no water was lost).");
  dirty = true;
});

/* Balance for bolts */
const feBal = makeBalance($("feBal"));
function weighBolt(i) {
  const b = BOLTS[i];
  if (bolt === b) { say(`Bolt ${b.name} is in the cylinder. Take it out first.`); return; }
  onBalance = i;
  feBal.set(boltLying(b, 150, 96, 1.2), b.mass);
  say(`Bolt ${b.name} is on the balance.`);
  updateTray();
}
function clearBalance() { onBalance = null; feBal.set("", null); updateTray(); }
$("feClear").addEventListener("click", clearBalance);

function dropBolt(i) {
  const b = BOLTS[i];
  if (bolt) { say(`Take bolt ${bolt.name} out first. One bolt at a time.`); return; }
  if (water < b.minLevel) { say(`Not enough water to completely cover bolt ${b.name}. Add more water first.`); return; }
  if (onBalance === i) clearBalance();
  bolt = b; falling = true; boltV = 0; boltY = C.top + 20;
  updateTray();
  say(`Bolt ${b.name} is in. Read the new water level.`);
  dirty = true;
}

/* Bolt tray */
$("tray").innerHTML = BOLTS.map((b, i) =>
  `<div class="card" data-card="${i}">
     <svg viewBox="0 0 160 56"><g transform="translate(6 28) rotate(90)">${boltMarkup(b, 0, 0)}</g></svg>
     <b>Bolt ${b.name}</b>
     <div class="row">
       <button class="btn sm" data-drop="${i}">Into cylinder</button>
       <button class="btn sm" data-weigh="${i}">Weigh</button>
     </div>
   </div>`).join("");
document.querySelectorAll("[data-drop]").forEach(btn =>
  btn.addEventListener("click", () => dropBolt(+btn.dataset.drop)));
document.querySelectorAll("[data-weigh]").forEach(btn =>
  btn.addEventListener("click", () => weighBolt(+btn.dataset.weigh)));
function updateTray() {
  document.querySelectorAll("[data-card]").forEach(card => {
    const i = +card.dataset.card;
    card.classList.toggle("sel", (!!bolt && BOLTS[i] === bolt) || onBalance === i);
  });
}

/* Animation loop */
function loop(t) {
  const dt = lastT ? Math.min(0.05, (t - lastT) / 1000) : 0;
  lastT = t;
  if (falling) {
    boltV += 2500 * dt;
    boltY += boltV * dt;
    if (boltY >= C.y0) { boltY = C.y0; falling = false; overflowCheck(); }
    dirty = true;
  }
  const tg = targetLevel();
  if (shown !== tg) {
    const step = 25 * dt, diff = tg - shown;
    shown = Math.abs(diff) <= step ? tg : shown + Math.sign(diff) * step;
    dirty = true;
  }
  if (dirty) { renderCyl(); dirty = false; }
  requestAnimationFrame(loop);
}


renderCyl();
makeLens($("cylSvg"), "cScene", 80, 1.5, $("cLensBtn"));
requestAnimationFrame(loop);
fitToScreen();
</script>
</body>
</html>
